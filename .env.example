# --- OrbitalIQ configuration ---

# NVIDIA NIM (NVIDIA Inference Microservices) API access — powers the
# executive-briefing Report Agent.
# Get a free API key at https://build.nvidia.com after signing in with NVIDIA NGC.
NVIDIA_API_KEY=nvapi-REPLACE_ME
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_CHAT_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_NIM_EMBED_MODEL=nvidia/nv-embedqa-e5-v5

# Set to true to run the LLM narrative step fully offline using a
# deterministic template instead of calling the NVIDIA NIM API (used for
# CI/tests and for demos without an API key). Set to false once
# NVIDIA_API_KEY above is a real key.
ORBITALIQ_OFFLINE_MODE=true

# --- Live financial & satellite-imagery data sources ---
# When true (the default — this is the "honest data" mode), the Ingestion
# Agent calls genuine, entirely free, keyless public APIs for every signal:
#   - SEC EDGAR XBRL company facts   (revenue/R&D/capex growth) — keyless,
#     only requires a descriptive User-Agent string (see below)
#   - NASA GIBS satellite imagery    (bi-temporal change pair)  — keyless
#   - US Census Bureau Geocoder      (company facility coordinates,
#     resolved from the SEC-registered business address) — keyless
# Any source that's unreachable or has no coverage for a given
# ticker/location falls back automatically per-signal (never fails the
# whole assessment); every result's `data_sources` field discloses exactly
# which signals were live. None of these sources has any paid tier or usage
# cost — this pipeline's data layer is free to run indefinitely.
# Set to false to force the fully offline, deterministic synthetic-data
# demo mode (instant, no network required — also what the test suite uses).
ORBITALIQ_LIVE_DATA_MODE=true
LIVE_DATA_TIMEOUT_SECONDS=6.0

# SEC EDGAR requires no API key — only a descriptive User-Agent header per
# its fair-access policy: https://www.sec.gov/os/webmaster-faq#developers
# Set this to "Your Name your.email@example.com" before heavy use.
SEC_EDGAR_USER_AGENT=OrbitalIQ-Portfolio-Project research@example.com

# US Census Bureau Geocoder base URL — free, keyless, no account needed.
# Used only to turn a company's real SEC-registered business address into
# verified facility coordinates for the "enter just a company name" resolve
# workflow (POST /api/v1/companies/resolve). The default below is the real
# public endpoint; there is normally no reason to change it.
CENSUS_GEOCODER_BASE_URL=https://geocoding.geo.census.gov/geocoder

# Vision model device: "cuda", "cpu", or "auto" (auto-detects a GPU and
# falls back to CPU when none is available). "cpu" runs fine on a modest
# laptop — the CNN is intentionally small (~90K params).
ORBITALIQ_VISION_DEVICE=auto

# Storage
DATABASE_URL=sqlite:///./orbitaliq.db

# --- Enterprise dashboard extras ---

# Strict real-data (enterprise) mode: requires ORBITALIQ_LIVE_DATA_MODE=true
# above. When true, a non-live (fallback) satellite tile pair is never
# rendered by /api/v1/satellite/change-pair as if it were real — the API
# returns an explicit "unavailable" reason instead. It does NOT alter the
# composite Momentum Score's own long-standing fallback-labeled behavior
# (see README > Known limitations). Off by default.
ORBITALIQ_STRICT_REAL_DATA_MODE=false

# Watchlist escalation webhook. Unset (the default): every WATCH/REVIEW/
# HIGH_SIGNAL escalation is still logged and disclosed via
# `webhook_status: STUBBED_NO_WEBHOOK_CONFIGURED` — nothing is silently
# dropped, but no external system is actually notified. Set this to a real
# Slack/Teams incoming-webhook URL to make dispatch operational with no
# other code change.
# WATCHLIST_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/ME

# App
ORBITALIQ_ENV=development
LOG_LEVEL=INFO
