flowchart TB
    subgraph CLIENT["Client Layer"]
        AN["Analyst / Consultant\n(REST client, CLI demo, or BI tool)"]
    end

    subgraph API["FastAPI Application (src/orbitaliq/api)"]
        HEALTH["GET /health"]
        CREATE["POST /api/v1/assessments"]
        GET["GET /api/v1/assessments/:id"]
        LIST["GET /api/v1/assessments"]
    end

    subgraph ORCH["Agentic Orchestrator (agents/orchestrator.py)"]
        direction TB
        A1["1. Ingestion Agent\nfetch financial signals + bi-temporal satellite tile pair"]
        A2["2. Vision Agent\nCNN + change-index land-cover change detection"]
        A3["3. Intelligence Scoring Agent\ndeterministic composite momentum score"]
        A4["4. Report Agent\nLLM executive briefing"]
        A5["5. Watchlist Agent\nescalation decision + dispatch"]
        A1 --> A2 --> A3 --> A4 --> A5
    end

    subgraph NVIDIA["NVIDIA AI Stack"]
        NIM["NVIDIA NIM\n(build.nvidia.com / self-hosted)\nLlama 3.1 70B Instruct"]
        CNN["FacilityChangeCNN (PyTorch)\nCUDA-ready * CPU fallback\nbi-temporal 6-channel input\nONNX / TensorRT export path"]
    end

    subgraph LIVE["Real Public Data APIs (live by default, 100% free)"]
        direction TB
        SEC["SEC EDGAR XBRL Company Facts\nkeyless * revenue / R&D / capex growth"]
        GIBS["NASA GIBS\nkeyless * real VIIRS/MODIS satellite tiles\ncurrent + ~180d-prior pair"]
    end

    subgraph DATA["Data Layer"]
        FALLBACK["Synthetic fallback generator\n(per-signal, only when a live\nsource is unreachable/no-coverage)"]
        DB[("SQLAlchemy ORM\nSQLite (dev) / Postgres (prod)\n+ data_sources provenance per run")]
    end

    AN -->|HTTPS JSON| HEALTH
    AN -->|HTTPS JSON| CREATE
    AN -->|HTTPS JSON| GET
    AN -->|HTTPS JSON| LIST

    CREATE --> ORCH
    A1 --> SEC
    A1 --> GIBS
    A1 -.fallback only.-> FALLBACK
    A2 --> CNN
    A4 --> NIM
    ORCH -->|persist AssessmentRecord\nincl. data_sources| DB
    GET --> DB
    LIST --> DB

    classDef nvidia fill:#76b900,stroke:#4d7a00,color:#0b1f00,font-weight:bold;
    class NIM,CNN nvidia;
    classDef live fill:#1f6feb,stroke:#0d47a1,color:#ffffff,font-weight:bold;
    class SEC,GIBS live;
